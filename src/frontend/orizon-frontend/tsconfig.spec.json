{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "rootDir": ".",
    "types": ["jest", "node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "isolatedModules": true
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "jest.setup.ts"
  ]
}