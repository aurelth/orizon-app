{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "rootDir": "./src",
    "types": []
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.d.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.d.ts",
    "jest.setup.ts",
    // ALTERADO: exclusão explícita do interceptor spec que causava circular definition
    "src/app/core/auth/interceptors/refresh-token.interceptor.spec.ts"
  ]
}